# ====================================================================
# Designflow - environment configuration
# Copy this file to .env and edit. Lines starting with # are comments.
# Everything except SECRET_KEY and the database works in "mock" mode
# when left blank, so you can run the whole platform with no API keys.
# ====================================================================

# ---------- Core ----------
APP_NAME=Designflow
APP_ENV=development            # development | production
APP_URL=http://localhost:8000  # public URL of the site (used in links/emails)
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------- Database: MongoDB ----------
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Docker Compose: leave MONGO_URI blank and the bundled "mongo" service is used.
# Local MongoDB: mongodb://localhost:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB=designflow

# ---------- Redis (real-time + job queue). Blank = in-process fallback ----------
REDIS_URL=redis://redis:6379/0

# ---------- Primary admin (re-applied on every start; cannot be changed inside the app) ----------
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Your Name

# ---------- AI: ollama (local, free) | anthropic | mock ----------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434   # in Docker: http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b                 # run: ollama pull llama3.2:3b (fast); llama3.1 is better but slower
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=2048

# ---------- Pricing (per request; prices stored in USD, converted with these rates) ----------
DEFAULT_CURRENCY=USD
REPORTING_CURRENCY=GBP        # currency your revenue is reported/settled in (match your Stripe account's payout currency)
FX_GBP=0.79
FX_INR=84
# Optional per-agent overrides, e.g. LLM_MODEL_DESIGN=claude-opus-5-5
# LLM_MODEL_STRATEGY=
# Image generation provider for the Design Agent: mock | none
IMAGE_PROVIDER=mock
# AI images for logos and hero imagery: auto | openai | gemini | none (none = built-in vector engine only)
AI_IMAGE_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Lead discovery provider: web (free DuckDuckGo search) | serpapi
LEAD_PROVIDER=web
SERPAPI_KEY=

# ---------- Storage: local | gdrive ----------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
MAX_UPLOAD_MB=50
# Google Drive via service account. Share the root folder with the
# service account's email address, then put its folder id here.
GDRIVE_SERVICE_ACCOUNT_FILE=./secrets/gdrive-service-account.json
GDRIVE_ROOT_FOLDER_ID=

# ---------- Billing: mock | stripe ----------
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=USD

# ---------- Email: mock | smtp ----------
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hello@designflow.local
OUTREACH_AUTO_SEND=false       # true = Outreach Agent sends without approval

# ---------- Agents ----------
AGENTS_ENABLED=true
AGENT_AUTO_RUN_ON_ACCEPT=true  # run the pipeline automatically when a request is accepted
LEAD_AGENT_CRON=0 9 * * *       # daily 09:00
OUTREACH_FOLLOWUP_CRON=0 8 * * *
MARKETING_AGENT_CRON=0 10 * * 1,3,5

# ---------- Rate limiting ----------
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
